# Plantilla de variables. NO contiene secretos: genera tu .env con
#
#     python scripts/generar_env.py
#
# (crea claves aleatorias; el .env esta en .gitignore y NO debe viajar en el ZIP ni en el repositorio).
# Prefijo MATRICULAS_ a proposito, para no chocar con variables de otros servicios del monorepo.
MATRICULAS_DB_NAME=matriculas_db
MATRICULAS_DB_USER=matriculas_user
# Obligatoria (sin valor por defecto): contrasena de PostgreSQL.
MATRICULAS_DB_PASSWORD=vJaDm3Tt8ht1NGpUrNACVqCDUS2JTaau

# --- matriculas-api ---
# Claves de ADMINISTRADOR separadas por coma. OBLIGATORIA y SIN valor por defecto: la API no arranca
# si falta, es una clave publica conocida o tiene menos de 24 caracteres.
# Una real:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MATRICULAS_API_KEYS=2aeegeBaFbC8tfumd8C9IuuckhmuH4DS1KWXEzzicrM

# Interfaz donde se publica la API (por defecto solo loopback; ver README, seccion TLS).
# API_BIND=127.0.0.1
# DOCS_ENABLED=true          # false en produccion: no publica /docs ni /openapi.json
# STUDENT_KEY_TTL_DAYS=90    # vigencia de las claves de estudiante (0 = no caducan)
# AUTH_FAIL_LIMIT=20         # intentos de autenticacion fallidos por IP y ventana
# AUTH_FAIL_WINDOW_SECONDS=60
# WRITE_RATE_LIMIT_PER_MINUTE=60   # matricular/revertir por minuto con clave de estudiante (0 = sin limite)
# CURSOS_CACHE_TTL_SECONDS=5

# Timeout por llamada gRPC hacia Cupos, en segundos.
CUPOS_GRPC_TIMEOUT_SECONDS=2.0
# Fallas consecutivas hacia Cupos antes de abrir el circuit breaker.
CUPOS_CB_FAILURE_THRESHOLD=5
# Segundos que el circuit breaker permanece abierto antes de reintentar.
CUPOS_CB_RECOVERY_SECONDS=15.0

# Matriculas PENDIENTES: el cliente puede reintentar con la misma Idempotency-Key durante TTL/2; pasado
# el TTL el conciliador la anula y libera el cupo. El conciliador corre cada N segundos (0 = apagado).
PENDING_TTL_SECONDS=30
RECONCILE_INTERVAL_SECONDS=10
