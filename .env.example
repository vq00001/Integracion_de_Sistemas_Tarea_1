# Variables para el servicio matriculas-db / matriculas (CLI legado) /
# matriculas-api (API REST nueva).
# Prefijo MATRICULAS_ a proposito, para no chocar con variables de otros
# servicios del monorepo (ej. cupos) que puedan definir DB_NAME, etc.
MATRICULAS_DB_NAME=matriculas_db
MATRICULAS_DB_USER=matriculas_user
MATRICULAS_DB_PASSWORD=matriculas_pass

# --- matriculas-api (API REST, este es el servicio nuevo) ---
# API keys válidas separadas por coma (ver matriculas-api/README.md,
# sección "Autenticación"). Cambiar en cualquier ambiente que no sea
# desarrollo local.
# Clave de DESARROLLO: no uses este valor fuera de tu máquina. Para generar una real:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MATRICULAS_API_KEYS=dev-matriculas-key-123

# Timeout por llamada gRPC hacia Cupos, en segundos.
CUPOS_GRPC_TIMEOUT_SECONDS=2.0
# Fallas consecutivas hacia Cupos antes de abrir el circuit breaker.
CUPOS_CB_FAILURE_THRESHOLD=5
# Segundos que el circuit breaker permanece abierto antes de reintentar.
CUPOS_CB_RECOVERY_SECONDS=15.0

# Matrículas PENDIENTES (resultado incierto de Cupos, p. ej. tras un timeout):
# el cliente puede reintentar con la misma Idempotency-Key durante TTL/2; pasado el TTL
# el conciliador la anula y libera el cupo. El conciliador corre cada N segundos (0 = apagado).
PENDING_TTL_SECONDS=30
RECONCILE_INTERVAL_SECONDS=10
