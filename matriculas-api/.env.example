# Base de datos propia de Matrículas (SQLite por defecto para desarrollo
# local sin Docker; en docker-compose se apunta a matriculas-db/Postgres).
DATABASE_URL=sqlite:///./matriculas.db
# DATABASE_URL=postgresql+psycopg2://matriculas_user:matriculas_pass@matriculas-db:5432/matriculas_db

# Cliente gRPC hacia Cupos
CUPOS_GRPC_TARGET=localhost:50051
CUPOS_GRPC_TIMEOUT_SECONDS=2.0

# Circuit breaker hacia Cupos
CUPOS_CB_FAILURE_THRESHOLD=5
CUPOS_CB_RECOVERY_SECONDS=15.0

# API keys válidas, separadas por coma (ver README, sección Autenticación)
API_KEYS=dev-matriculas-key-123
