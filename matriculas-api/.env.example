# Base de datos propia de Matriculas (SQLite por defecto para desarrollo local sin Docker; en
# docker-compose se apunta a matriculas-db/Postgres).
DATABASE_URL=sqlite:///./matriculas.db
# DATABASE_URL=postgresql+psycopg2://matriculas_user:<contrasena>@matriculas-db:5432/matriculas_db

# Cliente gRPC hacia Cupos
CUPOS_GRPC_TARGET=localhost:50051
CUPOS_GRPC_TIMEOUT_SECONDS=2.0

# Circuit breaker hacia Cupos
CUPOS_CB_FAILURE_THRESHOLD=5
CUPOS_CB_RECOVERY_SECONDS=15.0

# API keys de ADMINISTRADOR, separadas por coma (ver README, seccion Autenticacion). OBLIGATORIA:
# sin valor por defecto; la API no arranca si falta o es una clave publica/corta (< 24 caracteres).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Matriculas PENDIENTES (ver README): ventana de reintento = TTL/2; conciliador cada N s (0 = apagado)
PENDING_TTL_SECONDS=30
RECONCILE_INTERVAL_SECONDS=10

# Autenticacion y abuso
STUDENT_KEY_TTL_DAYS=90
AUTH_FAIL_LIMIT=20
AUTH_FAIL_WINDOW_SECONDS=60
WRITE_RATE_LIMIT_PER_MINUTE=60

# Lectura de cursos y documentacion
CURSOS_CACHE_TTL_SECONDS=5
DOCS_ENABLED=true
# DEPRECATED_ROUTES={"/v1/ruta": {"deprecation": "@1793145600", "sunset": "Wed, 28 Oct 2027 00:00:00 GMT", "link": "https://..."}}
